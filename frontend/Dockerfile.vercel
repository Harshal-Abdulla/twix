# The built frontend, served by nginx.
#
# Vercel builds each service and then runs it. A Vite project has no start
# script, only build and preview, so when Vercel went looking for something to
# run it found nothing and the service exited with code 127. That took the
# whole deployment down with it: with the frontend dead, /api never reached the
# backend either.
#
# Giving the frontend an explicit container removes the guesswork. There is now
# one command, it is written down, and it is the same locally and on Vercel.

FROM node:22-alpine AS build
WORKDIR /build
# Dependencies first so this layer survives ordinary source edits.
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /build/dist /usr/share/nginx/html

# The app routes on the client, so any unknown path has to fall back to
# index.html rather than 404. Without try_files a refresh on /profile breaks.
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location / {' \
  '    try_files $uri $uri/ /index.html;' \
  '  }' \
  '}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

{
  "services": {
    "frontend": {
      "runtime": "container",
      "root": "frontend/",
      "entrypoint": "Dockerfile.vercel"
    },
    "backend": {
      "runtime": "container",
      "root": "backend/",
      "entrypoint": "Dockerfile.vercel",
      "functions": {
        "**": {
          "maxDuration": 60,
          "memory": 2048
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}

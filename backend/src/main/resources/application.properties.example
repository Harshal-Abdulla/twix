spring.application.name=Twix

# Copy this file to application.properties and fill in real values.
# Never commit the filled-in file.
spring.datasource.url=${TWIX_DB_URL:jdbc:postgresql://localhost:5432/twix}
spring.datasource.username=${TWIX_DB_USER:postgres}
spring.datasource.password=${TWIX_DB_PASSWORD:}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.web.cors.allowed-origin-patterns=*
